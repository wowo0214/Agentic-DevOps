{
  "name": "root_workspace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev:docs": "turbo run docs#dev",
    "dev:admin": "turbo run admin#dev",
    "lint": "turbo run lint",
    "fmt": "turbo run fmt",
    "fmt:check": "turbo run fmt:check",
    "check": "turbo run lint fmt:check",
    "prepare": "vp config --no-agent || exit 0"
  },
  "devDependencies": {
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "vite-plus": "^1.5.0",
    "vitest": "catalog:testing"
  },
  "packageManager": "pnpm@12.16.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.13.0",
      "onFail": "download"
    }
  }
}
