{
  "name": "agentic-devops",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun --bun turbo run build",
    "clean": "bun --bun turbo run clean",
    "dev:docs": "bun --bun turbo run docs#dev",
    "dev:admin": "bun --bun turbo run link-admin#dev",
    "check-types": "bun --bun turbo run check-types"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.20.0"
  },
  "overrides": {
    "typescript": "^7.0.2"
  },
  "patchedDependencies": {
    "next@16.4.0": "patches/next@16.4.0.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "unrs-resolver"
  ]
}
