{
  "name": "root_workspace",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "react": "^19",
      "react-dom": "^19",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "typescript": "^7"
    },
    "catalogs": {
      "testing": {
        "vitest": "^5"
      },
      "ui": {
        "tailwindcss": "^4"
      }
    }
  },
  "scripts": {
    "build": "bun --bun turbo run build",
    "clean": "bun --bun turbo run clean",
    "dev:docs": "bun --bun turbo run docs#dev",
    "dev:admin": "bun --bun turbo run admin#dev"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "vitest": "catalog:testing"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.20.0"
  },
  "overrides": {},
  "patchedDependencies": {
    "next@16.4.0": "patches/next@16.4.0.patch"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "unrs-resolver"
  ]
}
