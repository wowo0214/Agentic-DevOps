{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/.sl",
    "**/.repo",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/node_modules",
    "**/.turbo",
    "**/.vscode",
    "**/.next",
  ],
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "vp",
          "arguments": [
            "fmt",
            "--stdin-filepath",
            "{buffer_path}",
          ],
        },
      },
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "vp",
          "arguments": [
            "fmt",
            "--stdin-filepath",
            "{buffer_path}",
          ],
        },
      },
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "vp",
          "arguments": [
            "fmt",
            "--stdin-filepath",
            "{buffer_path}",
          ],
        },
      },
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "vp",
          "arguments": [
            "fmt",
            "--stdin-filepath",
            "{buffer_path}",
          ],
        },
      },
    },
  },
}
