{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "ES2015"
    ],
    "sourceMap": true,
    "types": [
      "node"
    ],
    "strictNullChecks": true,
    "paths": {
      "@repo/ui": [
        "./src"
      ],
      "@repo/ui/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "."
  ],
  "exclude": [
    "dist",
    "build",
    "node_modules"
  ]
}
