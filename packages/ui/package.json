{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/**",
    "dist"
  ],
  "exports": {
    "./*": {
      "import": {
        "types": "./dist/es/*.d.mts",
        "default": "./dist/es/*.mjs"
      },
      "require": {
        "types": "./dist/cjs/*.d.ts",
        "default": "./dist/cjs/*.js"
      }
    },
    "./counter-button/*": null,
    "./link/*": null,
    "./styles": "./dist/styles.css"
  },
  "scripts": {
    "build": "bun --bun tsdown",
    "dev": "bun --bun tsdown --watch",
    "check-types": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint src/",
    "test": "bun --bun jest",
    "test:registry": "bun run build && bun test registry-paths.test.mjs"
  },
  "devDependencies": {
    "@jest/globals": "30.5.1",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "26.4.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.9.1",
    "jest": "30.5.1",
    "tsdown": "0.23.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "better-auth": "^1.7.7",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth-ui/core": "^1.7.30",
    "@better-auth-ui/react": "^1.7.30",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@swc/helpers": "0.5.23",
    "@tanstack/react-form": "^1.33.5",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.54.0",
    "react-day-picker": "^10.0.2",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
