// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model user {
  id            String            @id(map: "user_pkey")
  name          String
  email         String            @unique(map: "user_email_key")
  emailVerified Boolean
  image         String?
  createdAt     TimestamptzString @default(now())
  updatedAt     TimestamptzString @default(now())
  accounts      account[]
  sessions      session[]

  @@map("user")
}

model account {
  id                    String             @id(map: "account_pkey")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString  @default(now())
  updatedAt             TimestamptzString
  user                  user               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_userId_fkey")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model prismaMigrations {
  id                VarChar(36)        @id(map: "_prisma_migrations_pkey")
  checksum          VarChar(64)
  finishedAt        TimestamptzString? @map("finished_at")
  migrationName     VarChar(255)       @map("migration_name")
  logs              String?
  rolledBackAt      TimestamptzString? @map("rolled_back_at")
  startedAt         TimestamptzString  @default(now()) @map("started_at")
  appliedStepsCount Int                @default(0) @map("applied_steps_count")

  @@map("_prisma_migrations")
}

model session {
  id        String            @id(map: "session_pkey")
  expiresAt TimestamptzString
  token     String            @unique(map: "session_token_key")
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString
  ipAddress String?
  userAgent String?
  userId    String
  user      user              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_userId_fkey")

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model verification {
  id         String            @id(map: "verification_pkey")
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}
