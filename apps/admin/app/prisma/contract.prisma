// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model User {
  id            String             @id(map: "user_pkey")
  name          String
  email         String             @unique(map: "user_email_key")
  emailVerified Boolean
  image         String?
  createdAt     TimestamptzString  @default(now())
  updatedAt     TimestamptzString  @default(now())
  phone         String?
  isAnonymous   Boolean?
  role          String?
  banned        Boolean?           @default(false)
  banReason     String?
  banExpires    TimestamptzString?
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Account {
  id                    String             @id(map: "account_pkey")
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString  @default(now())
  updatedAt             TimestamptzString
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "account_userId_fkey")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model PrismaMigrations {
  id                VarChar(36)        @id(map: "_prisma_migrations_pkey")
  checksum          VarChar(64)
  finishedAt        TimestamptzString? @map("finished_at")
  migrationName     VarChar(255)       @map("migration_name")
  logs              String?
  rolledBackAt      TimestamptzString? @map("rolled_back_at")
  startedAt         TimestamptzString  @default(now()) @map("started_at")
  appliedStepsCount Int                @default(0) @map("applied_steps_count")

  @@map("_prisma_migrations")
}

model Session {
  id             String            @id(map: "session_pkey")
  expiresAt      TimestamptzString
  token          String            @unique(map: "session_token_key")
  createdAt      TimestamptzString @default(now())
  updatedAt      TimestamptzString
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "session_userId_fkey")

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Verification {
  id         String            @id(map: "verification_pkey")
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @default(now())
  updatedAt  TimestamptzString @default(now())

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

enum ConversationType {
  @@type("pg/text@1")
  direct = "direct"
  group = "group"
}

enum ConversationMemberRole {
  @@type("pg/text@1")
  owner = "owner"
  member = "member"
}

model Conversation {
  id        String            @id @default(uuid())
  type      ConversationType
  title     String?
  createdBy String            @map("created_by")
  directKey String?           @unique @map("direct_key")
  createdAt TimestamptzString @default(now()) @map("created_at")
  lastSeq   Int               @default(0) @map("last_seq")
  creator   User              @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@check(expression: "(type = 'direct' AND direct_key IS NOT NULL AND length(btrim(direct_key)) > 0 AND title IS NULL) OR (type = 'group' AND direct_key IS NULL AND title IS NOT NULL AND length(btrim(title)) > 0)", name: "conversation_shape")
  @@index([createdBy])
  @@map("conversation")
}

model ConversationMember {
  conversationId    String                 @map("conversation_id")
  userId            String                 @map("user_id")
  memberRole        ConversationMemberRole @default(member) @map("member_role")
  joinedAt          TimestamptzString       @default(now()) @map("joined_at")
  lastReadMessageId String?                @map("last_read_message_id")
  conversation      Conversation           @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user              User                   @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lastReadMessage   Message?               @relation(fields: [conversationId, lastReadMessageId], references: [conversationId, id], onDelete: Restrict, onUpdate: Cascade, map: "member_last_read_message_fkey")

  @@id([conversationId, userId])
  @@index([userId, conversationId])
  @@index([conversationId, lastReadMessageId], name: "member_last_read_idx")
  @@map("conversation_member")
}

model Permission {
  code        String  @id
  name        String
  description String?

  @@map("permission")
}

model RolePermission {
  role           String
  permissionCode String     @map("permission_code")
  permission     Permission @relation(fields: [permissionCode], references: [code], onDelete: Restrict, onUpdate: Cascade)

  @@id([role, permissionCode])
  @@index([permissionCode])
  @@map("role_permission")
}

model Message {
  id              String            @id @default(uuid())
  conversationId  String            @map("conversation_id")
  senderId        String            @map("sender_id")
  clientMessageId String            @map("client_message_id")
  content         String
  seq             Int               @default(0)
  createdAt       TimestamptzString @default(now()) @map("created_at")
  conversation    Conversation      @relation(fields: [conversationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sender          User              @relation(fields: [senderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([conversationId, id])
  @@unique([conversationId, seq], map: "message_conversation_seq_key")
  @@unique([conversationId, senderId, clientMessageId], map: "message_client_dedup")
  @@index([conversationId, createdAt, id])
  @@index([senderId])
  @@check(expression: "length(btrim(content)) > 0", name: "message_content_not_empty")
  @@check(expression: "length(btrim(client_message_id)) > 0", name: "message_client_id_not_empty")
  @@map("message")
}
